rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Workspaces collection and all subcollections (channels, messages, tasks, documents, events, files, members)
    match /workspaces/{workspaceId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Users and user notifications
    match /users/{userId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
